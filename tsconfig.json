{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": { "react-liquis-glass": ["src/index.ts"], "react-liquis-glass/icons": ["src/icons/index.ts"] }
  },
  "include": ["src", ".storybook", "stories"]
}
